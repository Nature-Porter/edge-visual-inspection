{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","model_id","category","checkpoint_sha256","onnx_path","onnx_sha256","input","output","resize","preprocess_owner","normalization_owner","score_reduction","status","image_threshold","pixel_threshold","validation_manifest_sha256","training_manifest_sha256","stats_manifest_sha256","requested_precision","tools"],
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "nullable_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "tensor":{"type":"object","required":["name","shape","dtype"],"properties":{"name":{"type":"string","minLength":1},"shape":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":1}},"dtype":{"const":"float32"}}}
  },
  "properties":{
    "schema_version":{"const":1},"model_id":{"type":"string","minLength":1},"category":{"const":"metal_nut"},
    "checkpoint_sha256":{"$ref":"#/$defs/hash"},"onnx_path":{"type":"string","minLength":1},"onnx_sha256":{"$ref":"#/$defs/hash"},
    "input":{"allOf":[{"$ref":"#/$defs/tensor"},{"required":["color","layout","range"],"properties":{"shape":{"const":[1,3,256,256]},"color":{"const":"RGB"},"layout":{"const":"NCHW"},"range":{"const":[0,1]}}}]},
    "output":{"$ref":"#/$defs/tensor"},"resize":{"const":"opencv_inter_linear"},"preprocess_owner":{"const":"external"},"normalization_owner":{"const":"model"},"score_reduction":{"const":"max"},
    "status":{"enum":["calibrated","uncalibrated"]},"image_threshold":{"type":["number","null"]},"pixel_threshold":{"type":["number","null"]},
    "validation_manifest_sha256":{"$ref":"#/$defs/nullable_hash"},"training_manifest_sha256":{"$ref":"#/$defs/hash"},"stats_manifest_sha256":{"$ref":"#/$defs/hash"},
    "requested_precision":{"enum":["FP32","FP16","INT8/FP32","INT8/FP16"]},"tools":{"type":"object","minProperties":1},"smoke":{"type":"boolean"}
  },
  "allOf":[{"if":{"properties":{"status":{"const":"calibrated"}}},"then":{"properties":{"image_threshold":{"type":"number"},"validation_manifest_sha256":{"$ref":"#/$defs/hash"}}}}]
}
